# Debug lab â€” values.
#
# Lab rules (also in the assignment):
#   * You may change anything in this chart â€” values or templates.
#   * You may NOT change image.repository or image.tag.
#   * You may NOT modify anything under ../cluster-state/.
#   * You may NOT delete workloads to make a symptom disappear.

image:
  repository: docker.io/ebinterview/eb-debug-app
  tag: "1.0.1"
  pullPolicy: IfNotPresent

common:
  # Every workload serves plain HTTP on this port.
  port: 8080

backend:
  replicas: 1
  env:
    APP_MODE: "api"
    APP_NAME: "backend"
    VERSION: "2.0.0"
    PORT: "8080"
  resources:
    requests:
      cpu: "50m"
      memory: "64Mi"
    limits:
      cpu: "200m"
      memory: "128Mi"

gateway:
  replicas: 1
  env:
    APP_MODE: "gateway"
    APP_NAME: "gateway"
    VERSION: "2.0.0"
    PORT: "8080"
    BACKEND_URL: "http://backend:8080"
  resources:
    requests:
      cpu: "50m"
      memory: "64Mi"
    limits:
      cpu: "200m"
      memory: "128Mi"

worker:
  replicas: 1
  env:
    APP_MODE: "worker"
    APP_NAME: "worker"
    VERSION: "2.0.0"
    PORT: "8080"
  resources:
    requests:
      cpu: "50m"
      memory: "64Mi"
    limits:
      cpu: "200m"
      memory: "128Mi"

reporter:
  replicas: 1
  serviceAccountName: reporter
  env:
    APP_MODE: "reporter"
    APP_NAME: "reporter"
    VERSION: "2.0.0"
    PORT: "8080"
  resources:
    requests:
      cpu: "50m"
      memory: "64Mi"
    limits:
      cpu: "200m"
      memory: "128Mi"

metrics:
  replicas: 1
  env:
    APP_MODE: "api"
    APP_NAME: "metrics"
    VERSION: "2.0.0"
    PORT: "8080"
  resources:
    requests:
      cpu: "50m"
      memory: "64Mi"
    limits:
      cpu: "200m"
      memory: "128Mi"

migrate:
  enabled: true
  backoffLimit: 2
PS C:\Users\bhoga\OneDrive\Documents\Projects\cloud-native-service-runtime\lab> Get-Content .\broken-chart\templates\reporter.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: reporter
  labels:
    app: reporter
    {{- include "lab.labels" . | nindent 4 }}
spec:
  replicas: {{ .Values.reporter.replicas }}
  selector:
    matchLabels:
      app: reporter
  template:
    metadata:
      labels:
        app: reporter
        {{- include "lab.labels" . | nindent 8 }}
    spec:
      serviceAccountName: {{ .Values.reporter.serviceAccountName }}
      containers:
        - name: reporter
          image: "{{ .Values.image.repository }}:{{ .Values.image.tag }}"
          imagePullPolicy: {{ .Values.image.pullPolicy }}
          ports:
            - name: http
              containerPort: {{ .Values.common.port }}
          env:
            - name: NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
            {{- range $name, $value := .Values.reporter.env }}
            - name: {{ $name }}
              value: {{ $value | quote }}
            {{- end }}
          readinessProbe:
            httpGet:
              path: /healthz
              port: {{ .Values.common.port }}
            initialDelaySeconds: 3
            periodSeconds: 5
            timeoutSeconds: 3
          securityContext:
            runAsNonRoot: true
            runAsUser: 65532
            readOnlyRootFilesystem: true
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          resources:
            {{- toYaml .Values.reporter.resources | nindent 12 }}
---
apiVersion: v1
kind: Service
metadata:
  name: reporter
  labels:
    app: reporter
    {{- include "lab.labels" . | nindent 4 }}
spec:
  selector:
    app: reporter
  ports:
    - name: http
      port: 8080
      targetPort: {{ .Values.common.port }}
