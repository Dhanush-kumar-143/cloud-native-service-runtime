kind: Service
metadata:
  name: reporter
  labels:
    app: reporter
    {{- include "lab.labels" . | nindent 4 }}
spec:
  selector:
    app: reporter
  ports:
    - name: http
      port: 8080
      targetPort: {{ .Values.common.port }}
